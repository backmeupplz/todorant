# Settings for docker-compose.yml: cp .env.example .env and set JWT. Everything else is optional:
# an empty value keeps that feature off. The guide: docs/self-hosting.md

# Required. Signs every sign-in token: long, random and secret (openssl rand -hex 32).
# Changing it later signs everyone out.
JWT=

# MongoDB connection string. Unset, the backend uses the compose file's own mongo service.
# MONGO=mongodb://mongo:27017/todorant

# The backend's address as browsers and phones reach it (the web app calls it directly):
# http://localhost:1337 on this machine, https://api.todo.example.com behind a reverse proxy
TODORANT_API=http://localhost:1337

# Anyone who can reach the backend can create an email + password account: set to false once yours exist
PASSWORD_SIGNUP=true

# Email verification for those sign-ups: with an SMTP server set, signing up emails a confirmation link
# (built from BACKEND_URL, else TODORANT_API) and the account exists once it's opened. Empty: no emails
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Todorant <todorant@example.com>
# Where replies to those emails go, when not MAIL_FROM
MAIL_REPLY_TO=

# Your own Telegram bot (token from @BotFather) for accounts signed in with Telegram: add todos by messaging it.
# The apps' Telegram sign-in buttons use the official @todorant_bot, so most servers leave this empty
TELEGRAM_LOGIN_TOKEN=
# Voice messages to the bot, transcribed by wit.ai (needs ffmpeg, which the image doesn't include):
# WIT_LANGUAGES={"English":"<wit.ai server token>"}
WIT_LANGUAGES=

# Errors reported to a Telegram chat instead of only the log: a second bot's token and the chat id
TELEGRAM_ERROR_SENDER_TOKEN=
CHAT_ID=

# Google Calendar sync: an OAuth client (Google Cloud console, Calendar API) whose authorized redirect URI
# is <BASE_URL>/google_calendar_setup_web. BASE_URL is the web app's address, BACKEND_URL the backend's
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_SECRET=
BASE_URL=
BACKEND_URL=

# Facebook sign-in, for apps built with your own Facebook app (the official apps use Todorant's)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Sign in with Apple key for /login/apple (default: key M3N8Y594JS, team ACWP4F58HZ, backend/assets/AppleAuth.p8).
# Set the key either as its .p8 contents (APPLE_PRIVATE_KEY, \n allowed for newlines) or as a path to the file
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=
APPLE_KEY_PATH=
